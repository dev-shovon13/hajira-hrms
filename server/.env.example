# ---- runtime ----
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app (used in email links).
APP_URL=http://localhost:3000
# Public URL of this API (used for locally stored upload URLs).
API_URL=http://localhost:4000
# Set to true when running behind a reverse proxy (Render, Railway, Nginx) so req.ip is the client IP.
TRUST_PROXY=false

# ---- database ----
# On Neon, run `neon env pull` in the repo root instead: it writes both URLs to ../.env.local,
# which is loaded before this file. DATABASE_URL is the pooled URL (host ends in -pooler) for the app;
# DATABASE_URL_UNPOOLED is the direct URL Prisma Migrate needs. With plain Postgres, set both to the same URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hajira?schema=public
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/hajira?schema=public

# ---- auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Cookie domain; leave empty for host-only cookies (recommended when the web app proxies /api).
COOKIE_DOMAIN=

# ---- office ----
OFFICE_TIMEZONE=Asia/Dhaka

# ---- seed ----
SEED_ADMIN_EMAIL=admin@hajira.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_PASSWORD=Demo@12345

# ---- email (leave SMTP_HOST empty to print emails to the server log instead) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hajira <no-reply@hajira.test>"

# ---- uploads (leave CLOUDINARY_URL empty to store files in ./uploads) ----
CLOUDINARY_URL=
UPLOAD_MAX_MB=5

# ---- jobs ----
ENABLE_CRON=true
